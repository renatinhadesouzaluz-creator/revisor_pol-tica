# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ser enviado ao Git (já está no .gitignore).

# Chave da API da Anthropic (obrigatória para a revisão por IA).
ANTHROPIC_API_KEY=

# Modelo utilizado na revisão (padrão: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Profundidade da análise: low | medium | high | xhigh | max (padrão: high).
# Valores maiores tendem a ser mais criteriosos, porém mais lentos e caros.
# REVIEW_EFFORT=high

# Limite de tamanho da resposta da IA, em tokens (padrão: 64000).
# REVIEW_MAX_TOKENS=64000

# Porta e endereço do servidor. Use HOST=0.0.0.0 para disponibilizar na rede.
# PORT=3000
# HOST=127.0.0.1

# Senha de acesso (recomendado ao disponibilizar na rede).
# APP_USER=
# APP_PASSWORD=

# Limites
# MAX_UPLOAD_MB=10
# MAX_DOC_CHARS=300000
# MAX_CONCURRENT_REVIEWS=3

# Avançado
# STRUCTURED_OUTPUT=true   # false = descreve o formato JSON no prompt em vez de usar structured outputs
# REFUSAL_FALLBACK=true    # false = desativa o modelo alternativo em caso de recusa
# DEMO_MODE=false          # somente para testes internos: revisão simulada, sem IA
